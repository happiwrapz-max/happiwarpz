# ====================================================================
# HAPPIWRAPZ PRODUCTION & VERCEL ENVIRONMENT VARIABLES
# Replace placeholders with values from your provider dashboards before configuring Vercel.
# ====================================================================

# ── 1. Firebase Analytics & Auth ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_FIREBASE_MEASUREMENT_ID

# ── 2. Supabase Postgres Database (Transaction Pooler - Port 6543) ──
# Replace [YOUR-PASSWORD] with your actual Supabase database password
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true

# ── 3. Supabase Direct Connection (Session Mode / Migrations - Port 5432) ──
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/postgres

# ── 4. Supabase API Configuration ───────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# ── 5. Storefront Base URL (Vercel Domain or Custom Domain) ──────────
NEXT_PUBLIC_SITE_URL=https://your-domain.example

# ── 6. Cloudinary Cloud Storage (Images stored in Cloudinary CDN) ─────
CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME
CLOUDINARY_API_KEY=YOUR_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=YOUR_CLOUDINARY_API_SECRET
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=YOUR_CLOUD_NAME

# ── 7. Redis High-Performance Cache (Optional - Upstash / Redis Labs / Local) ──
# If omitted or offline, the app automatically falls back to built-in in-memory TTL caching with zero downtime.
REDIS_URL=redis://default:PASSWORD@HOST:6379
# Or Upstash Redis:
# UPSTASH_REDIS_REST_URL="https://your-upstash-endpoint.upstash.io"
# UPSTASH_REDIS_REST_TOKEN="your-upstash-token"
